# Copy to .env and fill in. .env is git-ignored and must never be committed.
# Most of this project's data sources need no key at all; see docs/05-TOOLS-SETUP.md.

# --- Required ---
ANTHROPIC_API_KEY=

# --- Optional: only needed for specific channels ---
# Literature full-text mining at volume (Europe PMC works without a key for normal use)
NCBI_API_KEY=

# GPU dispatch, if not running locally
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# Slurm over SSH, if using an HPC login node
SLURM_HOST=
SLURM_USER=

# --- Sealed split ---
# The key is NOT stored here. scripts/unseal.py prompts for it interactively,
# so that unsealing cannot happen non-interactively or inside an agent.
